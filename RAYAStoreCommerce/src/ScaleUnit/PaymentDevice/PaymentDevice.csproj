<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\CustomizationPackage.props" />
  <Import Condition=" '$(EAZFUSCATOR_NET_HOME)' != '' and Exists('$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets') " Project="$(EAZFUSCATOR_NET_HOME)\Integration\MSBuild\Eazfuscator.NET.targets" />
  <PropertyGroup>
    <AssemblyName>RR.PaymentDeviceNBE</AssemblyName>
    <RootNamespace>RR.PaymentDeviceNBE</RootNamespace>
    <TargetFramework>netstandard2.0</TargetFramework>
    <!-- Eazfuscator.NET is integrated with this project at MSBuild level: https://www.gapotchenko.com/eazfuscator.net/kb/100036 -->
    <EazfuscatorIntegration>MSBuild</EazfuscatorIntegration>
    <EazfuscatorActiveConfiguration>Release</EazfuscatorActiveConfiguration>
    <EazfuscatorCompatibilityVersion>2020.4</EazfuscatorCompatibilityVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Dynamics.Commerce.Sdk.HardwareAndPeripherals" Version="$(CommerceSdkPackagesVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RR.Dynamics.Retail.Payment.NBE">
      <HintPath>..\NBE.Portable\bin\Debug\netstandard2.0\RR.Dynamics.Retail.Payment.NBE.dll</HintPath>
    </Reference>
    <Reference Include="RR.Utility">
      <HintPath>..\NBE.Portable\RR.Utility.dll</HintPath>
    </Reference>
  </ItemGroup>
