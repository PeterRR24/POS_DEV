<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\CustomizationPackage.props " />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Dynamics.Commerce.Sdk.Installers.StoreCommerce" Version="$(CommerceSdkPackagesVersion)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ChannelDatabase\RAYACommerce.ChannelDatabase.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\CommerceRuntime\RAYACommerce.CommerceRuntime.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\HardwareStation\RAYACommerce.HardwareStation.csproj" />
    <ProjectReference Include="..\Pos\RAYACommerce.POS.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
 <ItemGroup>
	 <!--  Settings included in the CommerceRuntimeExtensionSettings item group will be added to the generated CommerceRuntime config file and available at runtime in the CommerceRuntime extension. -->

    <CommerceRuntimeExtensionSettings Include="ext.Contoso.IncludeExtensionPropertiesInProductSearch">
      <Value>true</Value>
    </CommerceRuntimeExtensionSettings>
  </ItemGroup>
 <ItemGroup>
   <Reference Include="RR.Dynamics.Retail.Payment.NBE">
     <HintPath>..\NBE.Portable\bin\Debug\netstandard2.0\RR.Dynamics.Retail.Payment.NBE.dll</HintPath>
   </Reference>
   <Reference Include="RR.Utility">
     <HintPath>..\NBE.Portable\bin\Debug\netstandard2.0\RR.Utility.dll</HintPath>
   </Reference>
 </ItemGroup>
</Project>