<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\CustomizationPackage.props" />

	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
	</PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Dynamics.Commerce.Sdk.HardwareAndPeripherals" Version="$(CommerceSdkPackagesVersion)" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="BanqueMisr">
      <HintPath>BanqueMisr.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>..\Utility\bin\Debug\netstandard2.0\Newtonsoft.Json.dll</HintPath>
    </Reference>
    <Reference Include="RR.Dynamics.Retail.Payment.NBE">
      <HintPath>..\NBE.Portable\bin\Debug\netstandard2.0\RR.Dynamics.Retail.Payment.NBE.dll</HintPath>
    </Reference>
    <Reference Include="RR.Retail.Security">
      <HintPath>..\..\..\RR.Retail.Security.dll</HintPath>
    </Reference>
    <Reference Include="RR.Utility">
      <HintPath>..\NBE.Portable\bin\Debug\netstandard2.0\RR.Utility.dll</HintPath>
    </Reference>
    <Reference Include="RRMiseCon">
      <HintPath>RRMiseCon.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>